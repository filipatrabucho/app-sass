APP_NAME="Plataforma RH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.nossaapp.localhost:8080
APP_TIMEZONE=Europe/Lisbon

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Plataforma / multi-tenancy -------------------------------------------
# Domínios do painel central (separados por vírgula).
CENTRAL_DOMAINS=admin.nossaapp.localhost
# Cada tenant fica em {subdominio}.TENANT_BASE_DOMAIN
TENANT_BASE_DOMAIN=nossaapp.localhost
# Usado para construir links enviados por email (ex.: reposição de password).
FRONTEND_SCHEME=http
FRONTEND_PORT=8080
# Prefixo das BDs de tenant (tenant_<uuid>).
TENANCY_DB_PREFIX=tenant_
TENANCY_DB_SUFFIX=
LICENSES_CACHE_TTL=3600
CENTRAL_ADMIN_EMAIL=admin@nossaapp.pt
CENTRAL_ADMIN_PASSWORD=password

# --- Base de dados central --------------------------------------------------
# O utilizador tem de poder criar bases de dados (uma por tenant).
DB_CONNECTION=central
DB_DRIVER=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=central
DB_USERNAME=app
DB_PASSWORD=secret

# --- Sessões / cache / filas (Redis) -----------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Vazio = cookie host-only (cada subdomínio tem a sua sessão).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email (Mailpit em dev: http://localhost:8025) -----------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responder@nossaapp.pt"
MAIL_FROM_NAME="${APP_NAME}"
